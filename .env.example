# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your own values.
# `.env` holds live secrets and must never be committed.
# Every integration is optional — leave a block blank and that
# destination simply logs what it *would* have sent (dry run),
# so the whole system still runs end to end without credentials.
# ─────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────
PORT=3000

# Protects /admin and the admin API. Leave blank for local dev.
ADMIN_TOKEN=

# ── Airtable ────────────────────────────────────────────────
# 1. Create a base at https://airtable.com
# 2. Create a token at https://airtable.com/create/tokens
#    scopes:  data.records:write , schema.bases:read
#    access:  the base you just created
# 3. Base ID is in the base URL: airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Bookings

# ── Scheduler ───────────────────────────────────────────────
# How often the scheduler wakes up, in minutes.
SCHEDULER_INTERVAL_MINUTES=15

# Send the "your trip is coming up" reminder this many days before departure.
REMINDER_DAYS_BEFORE=3

# Flag a booking still 'pending' after this many hours as needing a chase.
PENDING_CHASE_HOURS=24
