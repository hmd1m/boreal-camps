{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "services": {
    "boreal-camps": {
      "root": ".",
      "entrypoint": "server.js",
      "buildCommand": "npm install"
    }
  },

  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "type": "service", "service": "boreal-camps" }
    }
  ],

  "crons": [
    { "path": "/api/cron", "schedule": "0 9 * * *" }
  ]
}
